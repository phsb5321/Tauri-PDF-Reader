{
  "name": "main — reviewed, signed, green",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    { "type": "required_signatures" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "Alignment Gate" },
          { "context": "Frontend Checks" },
          { "context": "Backend Checks" },
          { "context": "Contract Tests" },
          { "context": "Packaged PR-fast lane (critical-loop)" },
          { "context": "Trust anchor — base-owned contract vs head execution workflow" },
          { "context": "Analyze (javascript-typescript)" },
          { "context": "CodeQL" },
          { "context": "GitGuardian Security Checks" }
        ]
      }
    }
  ]
}
