#!/bin/sh

# Pre-commit hook for Tauri PDF Reader
# Runs frontend lint-staged and backend checks

set -e

echo "🔍 Running pre-commit checks..."

# The same goal + Spec Kit policy used by Pi settlement, Make and CI. Run it
# before the expensive language checks so an unplanned broad change fails fast.
echo "🎯 Running harness policy..."
make harness-check

# Frontend checks via lint-staged
echo "📦 Running lint-staged (TypeScript)..."
pnpm lint-staged --no-stash

# TypeScript type checking
echo "📝 Running TypeScript check..."
pnpm typecheck

# Backend checks (only if Rust files changed)
if git diff --cached --name-only | grep -q "src-tauri/"; then
  echo "🦀 Running Rust checks..."

  # Invoke the flake-pinned components directly. `cargo fmt/clippy` can resolve
  # an unrelated rustup shim from CARGO_HOME before these pinned binaries.
  echo "  → cargo-fmt --check"
  cd src-tauri && cargo-fmt --check

  echo "  → cargo-clippy"
  CARGO_BUILD_JOBS=1 cargo-clippy clippy -- -D warnings

  # Run tests with test-mocks feature
  echo "  → cargo test"
  cargo test --features test-mocks

  cd ..
fi

echo "✅ Pre-commit checks passed!"
