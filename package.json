{
  "name": "lectrice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "lint:boundaries": "eslint --rule 'boundaries/element-types: error' src/",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:check": "vitest run --coverage --coverage.thresholds.100 || echo 'Coverage below threshold!'",
    "test:arch": "vitest run src/__tests__/architecture/",
    "test:rust": "cd src-tauri && cargo test --features test-mocks",
    "test:rust:coverage": "cd src-tauri && cargo llvm-cov --features test-mocks",
    "knip": "knip",
    "type-coverage": "type-coverage --at-least 99.9 --no-cache",
    "typecheck": "tsc --noEmit",
    "verify": "./scripts/verify.sh",
    "prepare": "husky",
    "test:e2e": "wdio run wdio.conf.mjs",
    "test:e2e:native": "bash scripts/e2e-native.sh",
    "test:e2e:all": "bash scripts/e2e-all.sh"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "vitest related --run"
    ],
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "@fontsource/space-grotesk": "5.2.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-sql": "^2",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@wdio/cli": "9.27.2",
    "@wdio/local-runner": "9.27.2",
    "@wdio/mocha-framework": "9.27.2",
    "@wdio/spec-reporter": "9.27.2",
    "archunit": "^2.1.63",
    "eslint": "^9.17.0",
    "eslint-plugin-boundaries": "^5.3.1",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "knip": "6.29.0",
    "lint-staged": "^16.2.7",
    "prettier": "3.8.3",
    "type-coverage": "2.29.7",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "webdriverio": "9.27.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
