# Dependencies
node_modules

# Build outputs
dist/
.output/

# Rust/Cargo
src-tauri/target/

# Environment files
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test coverage
coverage/

# Tauri
src-tauri/gen/

# Husky runtime (generated by `husky install`; the hooks themselves are tracked)
.husky/_/

# opencode local scratch
.opencode/

# TypeScript
*.tsbuildinfo

# Database files (development)
*.db
*.db-journal

# pnpm 11 stray store (uses host pnpm 10 instead)
.pnpm-store/

# Generated by vite.config.ts (bundlePdfjsCmaps) — pdf.js CMap tables copied
# from node_modules/pdfjs-dist/cmaps at build/dev start. Not source.
public/cmaps/

# M2.4 verify receipt (run artifact, never committed)
verify-receipt.json

# Private real-book corpus — NEVER commit bytes, paths, or identity metadata.
# The runner reads the corpus and its .lectrice-manifest.json externally.
corpus-local/
/LECTRICE_REAL_PDF_CORPUS
/lectrice-corpus-results*
